{
  "mcpServers": {
    "local-codegraph": {
      "type": "stdio",
      "command": "pixi",
      "args": ["run", "mcp-codegraph"]
    },
    "local-github": {
      "type": "stdio",
      "command": "pixi",
      "args": ["run", "mcp-github"],
      "env": { "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_TOKEN}" }
    }
  }
}
