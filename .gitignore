*.pyc

# Binaries
# --------
*.dll
*.exe

# IDE files
# --------
.vs
.idea
.cache
.vscode/*
!.vscode/settings.json
!.vscode/launch.json
# T-E: PolyOrch managed regions are committed (fresh-clone F5 works; user rows live outside the region)
!.vscode/tasks.json

# Build dirs
# --------
out
log
dist
build
target
*.node
/install

# Temp dirs
# --------
nodejs
stash

# nodejs environments
# MCP bridge auto-install artifacts dropped at the repo root (npm state, not project files)
/package.json
/package-lock.json
node_modules
.npm-cache
.turbo

# Don't ignore files
# --------

# Agent dirs
.venv-openspace
.playwright-mcp
.codegraph
# Serena MCP project dir: the generated .serena/.gitignore only hides its own cache and
# local overrides -- repo-level rules also keep the memories dir out (D42: memory single
# source is .agents/memorys). .serena/project.yml IS tracked (reviewed config).
/.serena/cache
/.serena/memories
/.serena/project.local.yml
# Agent single-source: local MCP overrides (secrets). Canonical .agents/mcp.json is committed;
# this carries real credentials and must never be tracked (review #3 / adjudication 3-B).
.agents/mcp.local.json
# pixi environment manager
.pixi
.pixi-pack
.pixi-cache
.pixi/

# Activation trio: generated content -- bootstrap.sh copies it in the cold window,
# configure re-installs it via polyorch_pixi_setup(COPY_SCRIPTS). Single source: PolyOrch/scripts/.
/pixi.sh
/pixi.bat
/pixi.ps1
.sisyphus
.omo/*
!.omo/omo.jsonc

.codebuddy

# Official reference source clones (git-ignored, script-managed)
.refinfo
Testing/

# CMake preset build trees (T-A0' 2026-10-10): save-frame assets own build/, cargo owns target/
cmake-build/
cmake-build-release/
cmake-build-prebuilt/
cmake-build-debug/
cmake-build-ci/

# Local TLS artifacts of the wasm serve-https lane (wasm-serve-https-gen.sh)
.certs/

# clangd database for the Serena C++ language server (generated by cmake --preset <p>)
/compile_commands.json
