# ---------------------------------------------------------------------------
# .gitignore — generated artefacts, local state, and secrets never enter git.
#
# Verify one path before adding a rule:   git check-ignore -v <path>
# Confirm nothing tracked is silently ignored:
#   git ls-files -ci --exclude-standard     (must print nothing)
#
# Order: noise -> legacy toolchains -> IDE -> build -> node -> python ->
#        pixi -> secrets -> agent layers -> local notes -> wrapper -> clones
# ---------------------------------------------------------------------------

# --- OS / editor temporary noise -------------------------------------------
*~
*.autosave
*.core
*.orig
*.rej
.#*
*.*#
tags
.DS_Store
.directory
Thumbs.db
*.debug
*.app
# xemacs temporary files
*.flc
# vim swap files
.*.swp

# --- Visual Studio / MinGW (legacy template, kept for Windows contributors) --
*.ib_pdb_index
*.idb
*.ilk
*.pdb
*.sln
*.suo
*.vcproj
*vcproj.*.*.user
*.ncb
*.sdf
*.opensdf
*.vcxproj
*vcxproj.*
*.Debug
*.Release
*.dll
*.exe

# --- IDE local configuration ------------------------------------------------
.vs/
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/launch.json
# T-E: PolyOrch managed regions are committed (fresh-clone F5 works; user rows live outside the region)
!.vscode/tasks.json

# --- Build and test outputs -------------------------------------------------
# Save-frame assets own build/; cargo owns target/; CMake presets own cmake-build*/.
/build/
/target/
/out/
/dist/
/install/
/log/
cmake-build*/
# clangd database (cmake --preset <p>)
/compile_commands.json
# per-user CMake presets
/CMakeUserPresets.json
# ctest output
Testing/

# --- Node / MCP bridge (root manifests are npm state, not project files) ----
node_modules/
/package.json
/package-lock.json
.npm-cache/
.turbo/
*.node

# --- Python -----------------------------------------------------------------
*.pyc
__pycache__/
.venv-openspace/

# --- pixi environment manager ----------------------------------------------
.pixi/
.pixi-pack/
.pixi-cache/

# --- Local secrets and overrides (never track) ------------------------------
# Canonical .agents/mcp.json is committed; this file carries real credentials.
.agents/mcp.local.json
# local environment files (the .example template stays committable)
.env
.env.local
.env.*.local
!.env.example
# wasm serve-https TLS artefacts
.certs/
# Serena generated state (project.yml stays tracked by design)
/.serena/cache/
/.serena/memories/
/.serena/project.local.yml
# local tool caches
.cache/

# --- Agent host layers (generated from .agents/; never hand-edit) -----------
.codebuddy/
.qoder/
.trae/
.playwright-mcp/
.codegraph/
# pre-declared targets (disabled in agent-targets.json)
.claude/
.cursor/

# --- Local planning / scaffolding ------------------------------------------
.omo/*
!.omo/omo.jsonc
.sisyphus/
# legacy temp dirs (no current user; confirm before removing)
/stash/
/nodejs/

# --- Activation trio (generated; single source PolyOrch/scripts/) -----------
/pixi.sh
/pixi.bat
/pixi.ps1

# --- External reference clones (script-managed, read-only) ------------------
.refinfo/

# Repo-local cargo-binstall tools (mdbook-i18n-helpers); inside .gitignore since 2026-10-29
/.tools/
