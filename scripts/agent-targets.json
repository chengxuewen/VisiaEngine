{
  "rules_root": ".agents/rules",
  "memorys_root": ".agents/memorys",
  "mcp_source": ".agents/mcp.json",
  "mcp_local": ".agents/mcp.local.json",
  "memory_hub": "AGENTS.md",
  "skills_root": ".agents/skills",
  "constraints_hub": "CONSTRAINTS.md",
  "mcp_file_guard": ".mcp.json",
  "generated_tracked": ["AGENTS.md", "CONSTRAINTS.md", ".mcp.json", ".opencode/opencode.json", "SKILL.md"],
  "targets": [
    {
      "label": "codebuddy",
      "enabled": true,
      "rules_dir": ".codebuddy/rules",
      "rules_mode": "mdc",
      "langs": ["common","rust","cpp","web","typescript","python"],
      "always_on_rules": ["common-constraints","common-security"],
      "mcp_file": ".mcp.json",
      "mcp_shape": "mcpServers",
      "mcp_launcher": true
    },
    {
      "label": "claude",
      "enabled": false,
      "notes": "not used yet",
      "rules_dir": ".claude/rules",
      "mcp_file": ".claude/mcp.json",
      "mcp_shape": "mcpServers"
    },
    {
      "label": "cursor",
      "enabled": false,
      "notes": "not used yet",
      "rules_dir": ".cursor/rules",
      "mcp_file": ".cursor/mcp.json",
      "mcp_shape": "mcpServers"
    },
    {
      "label": "opencode",
      "enabled": true,
      "opencode_file": ".opencode/opencode.json",
      "mcp_shape": "named"
    }
  ]
}
