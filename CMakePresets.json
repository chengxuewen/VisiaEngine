{
  "version": 7,
  "configurePresets": [
    {
      "name": "default",
      "displayName": "Daily development (Debug, Qt/Rust auto-resolved; save-frame assets own build/, CMake tree in cmake-build/)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/cmake-build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_RUNTIME_OUTPUT_DIRECTORY": "${sourceDir}/cmake-build/bin",
        "CMAKE_LIBRARY_OUTPUT_DIRECTORY": "${sourceDir}/cmake-build/lib",
        "CMAKE_ARCHIVE_OUTPUT_DIRECTORY": "${sourceDir}/cmake-build/lib"
      }
    },
    {
      "name": "release",
      "displayName": "Pre-release verification (Release, same shape as default)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/cmake-build-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_RUNTIME_OUTPUT_DIRECTORY": "${sourceDir}/cmake-build-release/bin",
        "CMAKE_LIBRARY_OUTPUT_DIRECTORY": "${sourceDir}/cmake-build-release/lib",
        "CMAKE_ARCHIVE_OUTPUT_DIRECTORY": "${sourceDir}/cmake-build-release/lib"
      }
    },
    {
      "name": "prebuilt",
      "displayName": "Pure consumption (no cargo; VISIAENGINE_ARTIFACT_PATH required)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/cmake-build-prebuilt",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "debug",
      "displayName": "VSCode F5 (default + the PolyOrch CodeLLDB managed debug surface)",
      "inherits": "default",
      "cacheVariables": {
        "PolyOrch_VSCODE_DEBUG_ALL": "ON",
        "VISIAENGINE_QT": "ON"
      }
    },
    {
      "name": "ci-strict",
      "displayName": "CI anti-drift pin (both SDKs forced PIXI; not for daily use)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/cmake-build-ci",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "VISIAENGINE_QT": "ON",
        "VISIAENGINE_RUST_SDK": "PIXI",
        "VISIAENGINE_PIXI_ENV": "qt-spike"
      },
      "environment": {
        "CMAKE_PREFIX_PATH": "$penv{CONDA_PREFIX}"
      }
    }
  ],
  "buildPresets": [
    { "name": "default", "configurePreset": "default" },
    { "name": "release", "configurePreset": "release" },
    { "name": "prebuilt", "configurePreset": "prebuilt" },
    { "name": "debug", "configurePreset": "debug" },
    { "name": "ci-strict", "configurePreset": "ci-strict" }
  ],
  "testPresets": [
    {
      "name": "default",
      "configurePreset": "default",
      "output": { "outputOnFailure": true },
      "filter": { "exclude": { "label": "display" } }
    },
    {
      "name": "release",
      "configurePreset": "release",
      "output": { "outputOnFailure": true },
      "filter": { "exclude": { "label": "display" } }
    },
    {
      "name": "debug",
      "configurePreset": "default",
      "output": { "outputOnFailure": true },
      "filter": { "exclude": { "label": "display" } }
    },
    {
      "name": "ci-strict",
      "configurePreset": "ci-strict",
      "output": { "outputOnFailure": true },
      "filter": { "exclude": { "label": "display" } }
    }
  ]
}
